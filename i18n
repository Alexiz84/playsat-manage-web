  var STORAGE_LANGUAGE = 'playsat_web_language_v1';
  var currentLanguage = 'en';

  function supported(value) {
    return LANGUAGES.indexOf(value) !== -1;
  }

  function detectLanguage() {
    var saved = '';
    var browser = '';
    try { saved = localStorage.getItem(STORAGE_LANGUAGE) || ''; } catch (e) {}
    if (supported(saved)) return saved;
    browser = String((navigator.languages && navigator.languages[0]) || navigator.language || 'en');
    if (/^zh/i.test(browser)) return 'zh-CN';
    browser = browser.split('-')[0];
    return supported(browser) ? browser : 'en';
  }

  function format(text, params) {
    var out = String(text == null ? '' : text);
    var i;
    if (Array.isArray(params)) {
      for (i = 0; i < params.length; i += 1) {
        out = out.replace(new RegExp('\\{' + i + '\\}', 'g'), String(params[i] == null ? '' : params[i]));
      }
    } else if (params && typeof params === 'object') {
      Object.keys(params).forEach(function (key) {
        out = out.replace(new RegExp('\\{' + key + '\\}', 'g'), String(params[key] == null ? '' : params[key]));
      });
    }
    return out;
  }

  function t(key, params) {
    var table = MESSAGES[currentLanguage] || MESSAGES.en;
    var fallback = MESSAGES.en;
    var value = Object.prototype.hasOwnProperty.call(table, key) ? table[key] : fallback[key];
    return format(value == null ? key : value, params);
  }

  function apply(root) {
    root = root || document;
    Array.prototype.forEach.call(root.querySelectorAll('[data-i18n]'), function (node) {
      node.textContent = t(node.getAttribute('data-i18n'));
    });
    Array.prototype.forEach.call(root.querySelectorAll('[data-i18n-placeholder]'), function (node) {
      node.setAttribute('placeholder', t(node.getAttribute('data-i18n-placeholder')));
    });
    Array.prototype.forEach.call(root.querySelectorAll('[data-i18n-aria]'), function (node) {
      node.setAttribute('aria-label', t(node.getAttribute('data-i18n-aria')));
      if (node.tagName === 'IMG') node.setAttribute('alt', t(node.getAttribute('data-i18n-aria')));
    });
    document.documentElement.lang = currentLanguage;
    document.documentElement.dir = currentLanguage === 'ar' ? 'rtl' : 'ltr';
    document.title = 'PlaySat TV — ' + t('ps_playlist_title');
  }

  function setLanguage(value, persist) {
    currentLanguage = supported(value) ? value : 'en';
    if (persist !== false) {
      try { localStorage.setItem(STORAGE_LANGUAGE, currentLanguage); } catch (e) {}
    }
    apply(document);
    document.dispatchEvent(new CustomEvent('playsat-language-changed', { detail: { language: currentLanguage } }));
  }

  currentLanguage = detectLanguage();
  window.PlaySatI18n = {
    languages: LANGUAGES.slice(),
    t: t,
    apply: apply,
    setLanguage: setLanguage,
    getLanguage: function () { return currentLanguage; }
  };
